# ─────────────────────────────────────────────────────────────
# HD PORTFOLIO — BACKEND ENVIRONMENT
# Copy to .env and fill in your values
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection
DATABASE_URL=postgresql://hd_user:hd_password@localhost:5432/hd_portfolio

# JWT secrets — CHANGE THESE in production (use long random strings)
SECRET_KEY=hd-portfolio-secret-key-change-in-production
REFRESH_SECRET_KEY=hd-refresh-secret-key-change-in-production

# Server
HOST=0.0.0.0
PORT=8000
